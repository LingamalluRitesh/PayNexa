# ==============================================================================
# PayNexa Enterprise Payment Orchestrator - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL OVERRIDES IF DESIRED.
# The server is architected with safe zero-config fallbacks for immediate development.

# Server Network Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Security & Master Keys (Replace with strong random tokens in production)
PAYNEXA_MASTER_SECRET=paynexa_dev_master_secret_key_987654321
JWT_SECRET=paynexa_jwt_development_secret_signature_token
WEBHOOK_SIGNING_SECRET=whsec_paynexa_default_hmac_secret_2026

# Database Persistence
# Set to ":memory:" for transient in-memory database, or a filepath like "./data/paynexa.db"
DATABASE_URL=./data/paynexa.db
DATABASE_ENABLE_WAL=true

# Idempotency & Rate Limiting
IDEMPOTENCY_TTL_SECONDS=86400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500

# Risk & Fraud Engine Defaults
FRAUD_VELOCITY_WINDOW_SECONDS=300
FRAUD_VELOCITY_MAX_TX_COUNT=5
FRAUD_MAX_AMOUNT_USD_DEFAULT=10000
FRAUD_AUTOMATIC_CHALLENGE_SCORE=65
FRAUD_AUTOMATIC_DECLINE_SCORE=85

# Webhook Retries Policy
WEBHOOK_MAX_RETRIES=5
WEBHOOK_BASE_DELAY_MS=1000
WEBHOOK_REQUEST_TIMEOUT_MS=5000

# Client Configuration
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WS_BASE_URL=ws://localhost:4000
